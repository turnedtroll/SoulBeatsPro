<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.9</Version>
    <RootNamespace>SoulBeatsPro</RootNamespace>
    <AssemblyName>SoulBeatsPro</AssemblyName>
  </PropertyGroup>

  <!-- Exclude the example secrets file from compilation -->
  <ItemGroup>
    <Compile Remove="Secrets.example.cs" />
  </ItemGroup>

  <!-- admin.dat is an encrypted config generated by the admin panel, embedded inside the exe -->
  <ItemGroup>
    <EmbeddedResource Include="admin.dat" Condition="Exists('admin.dat')">
      <LogicalName>SoulBeatsPro.admin.dat</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

</Project>
